# Prometheus::create environment template.
# Copy to .env.local (git-ignored) and fill in the blanks. Never commit real keys.
# Values shown are public defaults; blank values are secrets or project-specific.

# --- Supabase (auth + private storage) -------------------------------------
# Project settings -> API. The URL and publishable key are public (browser);
# the secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=project-assets

# --- Postgres (Tiger Data) -------------------------------------------------
# Connection strings for the app and for the platform tests (use a separate database for tests).
DATABASE_URL=
TEST_DATABASE_URL=
# PEM of the database's CA if it is not publicly trusted (single line, \n-escaped). Leave blank otherwise.
DATABASE_CA_CERT=

# --- fal (image-to-3D; paid per call) --------------------------------------
# fal's docs call it FAL_KEY; FAL_API_KEY is also accepted.
FAL_API_KEY=

# --- Chert FaceTime calls (capture agent) ----------------------------------
# Chert app -> Developer -> Project API keys (scopes facetime:read, facetime:write).
CHERT_API_KEY=
CHERT_PROJECT_ID=
# The assigned FaceTime line (outbound video and caller-camera capture enabled).
CHERT_LINE_ID=
# Consenting test device: +15551234567 or an Apple ID email.
CHERT_TEST_DESTINATION=
# Optional override; only https://app.trychert.com is accepted.
# CHERT_BASE_URL=https://app.trychert.com/api/v1

# --- LiveKit (call media) --------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- ElevenLabs (spoken capture coaching) ----------------------------------
ELEVEN_API_KEY=

# --- Live-call ingestion (lib/capture/call-http.mts) -----------------------
# The running app's origin (HTTPS, or localhost for development).
INGEST_API_URL=http://localhost:3005
# Python of the capture-agent virtual environment (Windows path shown; Linux: .venv/bin/python).
CAPTURE_PYTHON=services/capture-agent/.venv/Scripts/python.exe
# INGEST_ACCESS_TOKEN is a short-lived Supabase user access token; set it in the
# shell for one run, never in this file.

# --- Platform tests (tests/platform) ---------------------------------------
PLATFORM_TEST_USER_A_EMAIL=hk003-owner@prometheus.test
PLATFORM_TEST_USER_B_EMAIL=hk003-other@prometheus.test

# First-visit notice that the app uses paid APIs: on | off (default off).
USAGE_WARNING=off
