{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^obs_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^prj_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^src_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sourceTimeUs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "frame": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^ast_[a-z0-9][a-z0-9_-]{2,63}$"
        },
        "mimeType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100
        },
        "byteSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 16384
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "assetId",
        "mimeType",
        "byteSize",
        "width",
        "height",
        "contentHash"
      ],
      "additionalProperties": false
    },
    "maskAssetIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ast_[a-z0-9][a-z0-9_-]{2,63}$"
      }
    },
    "objectId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^obj_[a-z0-9][a-z0-9_-]{2,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "camera": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "verticalFovDeg": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 180
            },
            "aspect": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "pose": {
              "type": "object",
              "properties": {
                "position": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 3,
                  "maxItems": 3
                },
                "rotation": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 4,
                  "maxItems": 4
                },
                "scale": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  ],
                  "items": false,
                  "minItems": 3,
                  "maxItems": 3
                }
              },
              "required": [
                "position",
                "rotation",
                "scale"
              ],
              "additionalProperties": false
            },
            "status": {
              "type": "string",
              "enum": [
                "estimated",
                "user_confirmed"
              ]
            },
            "method": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "verticalFovDeg",
            "aspect",
            "pose",
            "status",
            "method"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "quality": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "usable",
            "blurry",
            "dark",
            "occluded",
            "unknown"
          ]
        },
        "score": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "score"
      ],
      "additionalProperties": false
    },
    "mode": {
      "type": "string",
      "enum": [
        "evidence",
        "preview"
      ]
    },
    "capturedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "outOfOrder": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "projectId",
    "sourceId",
    "sequence",
    "sourceTimeUs",
    "frame",
    "maskAssetIds",
    "objectId",
    "camera",
    "quality",
    "mode",
    "capturedAt",
    "receivedAt",
    "outOfOrder"
  ],
  "additionalProperties": false,
  "$id": "prometheus-create/contracts/observation.schema.json",
  "title": "observation",
  "description": "CT-002: One frame of a source at a presentation time. Generated from lib/contracts; do not edit."
}
