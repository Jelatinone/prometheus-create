{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^src_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^prj_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "adapter": {
      "type": "string",
      "enum": [
        "upload",
        "phone_camera",
        "chert_facetime",
        "fixture"
      ]
    },
    "media": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "image"
            },
            "mimeType": {
              "type": "string",
              "minLength": 3
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 16384
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 16384
            }
          },
          "required": [
            "kind",
            "mimeType",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "video"
            },
            "mimeType": {
              "type": "string",
              "minLength": 3
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 16384
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 16384
            },
            "durationUs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "nominalFrameRate": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "num": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "den": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "num",
                    "den"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "mimeType",
            "width",
            "height",
            "durationUs",
            "nominalFrameRate"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "live_stream"
            },
            "width": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 16384
                },
                {
                  "type": "null"
                }
              ]
            },
            "height": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 16384
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "width",
            "height"
          ],
          "additionalProperties": false
        }
      ]
    },
    "assetId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^ast_[a-z0-9][a-z0-9_-]{2,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "contentHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "capturedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "captureSessionId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^cap_[a-z0-9][a-z0-9_-]{2,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "consent": {
      "type": "object",
      "properties": {
        "basis": {
          "type": "string",
          "enum": [
            "owner_upload",
            "participant_opt_in",
            "fixture"
          ]
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "note": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "basis",
        "recordedAt",
        "note"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "projectId",
    "adapter",
    "media",
    "assetId",
    "contentHash",
    "capturedAt",
    "captureSessionId",
    "consent",
    "createdAt"
  ],
  "additionalProperties": false,
  "$id": "prometheus-create/contracts/source.schema.json",
  "title": "source",
  "description": "CT-002: Registered photo, clip, or live stream. Generated from lib/contracts; do not edit."
}
