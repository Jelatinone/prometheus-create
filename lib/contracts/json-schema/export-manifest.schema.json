{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^exp_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "spec": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^prj_[a-z0-9][a-z0-9_-]{2,63}$"
        },
        "takeId": {
          "type": "string",
          "pattern": "^tk_[a-z0-9][a-z0-9_-]{2,63}$"
        },
        "revisionId": {
          "type": "string",
          "pattern": "^rev_[a-z0-9][a-z0-9_-]{2,63}$"
        },
        "cameraId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^cam_[a-z0-9][a-z0-9_-]{2,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "appearanceMode": {
          "type": "string",
          "enum": [
            "mesh",
            "capture_appearance",
            "wireframe"
          ]
        },
        "frames": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "still"
                },
                "frame": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "kind",
                "frame"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "range"
                },
                "startFrame": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endFrame": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "kind",
                "startFrame",
                "endFrame"
              ],
              "additionalProperties": false
            }
          ]
        },
        "resolution": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8192
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8192
            }
          },
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "background": {
          "type": "string",
          "enum": [
            "transparent",
            "solid",
            "source_plate"
          ]
        },
        "requestedFormat": {
          "type": "string",
          "enum": [
            "png",
            "glb",
            "webm",
            "mp4",
            "project_json"
          ]
        }
      },
      "required": [
        "projectId",
        "takeId",
        "revisionId",
        "cameraId",
        "appearanceMode",
        "frames",
        "resolution",
        "background",
        "requestedFormat"
      ],
      "additionalProperties": false
    },
    "actualFormat": {
      "type": "string",
      "enum": [
        "png",
        "glb",
        "webm",
        "mp4",
        "project_json"
      ]
    },
    "mimeType": {
      "type": "string",
      "minLength": 3
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assetId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^ast_[a-z0-9][a-z0-9_-]{2,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "fileName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "byteSize": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "contentHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "assetId",
          "fileName",
          "byteSize",
          "contentHash"
        ],
        "additionalProperties": false
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "scaleStatus": {
      "type": "string",
      "enum": [
        "estimated",
        "user_confirmed"
      ]
    },
    "engine": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "spec",
    "actualFormat",
    "mimeType",
    "outputs",
    "omissions",
    "scaleStatus",
    "engine",
    "createdAt"
  ],
  "additionalProperties": false,
  "$id": "prometheus-create/contracts/export-manifest.schema.json",
  "title": "export-manifest",
  "description": "CT-004: What was exported, with omissions. Generated from lib/contracts; do not edit."
}
