{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "revisionId": {
      "type": "string",
      "pattern": "^rev_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "takeId": {
      "type": "string",
      "pattern": "^tk_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "savedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "manifestHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "assetIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ast_[a-z0-9][a-z0-9_-]{2,63}$"
      }
    }
  },
  "required": [
    "revisionId",
    "takeId",
    "revision",
    "savedAt",
    "manifestHash",
    "assetIds"
  ],
  "additionalProperties": false,
  "$id": "prometheus-create/contracts/save-revision-response.schema.json",
  "title": "save-revision-response",
  "description": "CT-003: Save result. Generated from lib/contracts; do not edit."
}
