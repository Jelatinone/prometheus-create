{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "projectId": {
      "type": "string",
      "pattern": "^prj_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^src_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "adapter": {
      "type": "string",
      "enum": [
        "upload",
        "phone_camera",
        "chert_facetime",
        "fixture"
      ]
    },
    "captureSessionId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^cap_[a-z0-9][a-z0-9_-]{2,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sourceTimeUs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "capturedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "evidence",
        "preview"
      ]
    },
    "frame": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^ast_[a-z0-9][a-z0-9_-]{2,63}$"
        },
        "mimeType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100
        },
        "byteSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 16384
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "assetId",
        "mimeType",
        "byteSize",
        "width",
        "height",
        "contentHash"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "sourceId",
    "adapter",
    "captureSessionId",
    "sequence",
    "sourceTimeUs",
    "capturedAt",
    "mode",
    "frame"
  ],
  "additionalProperties": false,
  "$id": "prometheus-create/contracts/ingest-envelope.schema.json",
  "title": "ingest-envelope",
  "description": "CT-002: Per-frame ingestion message from any adapter. Generated from lib/contracts; do not edit."
}
